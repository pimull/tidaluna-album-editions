{
  "name": "pimull-album-editions-store",
  "description": "Album Editions for TidaLuna by pimull.",
  "type": "module",
  "scripts": {
    "watch": "concurrently \"pnpm:build --watch\" pnpm:serve",
    "build": "rimraf ./dist && tsx esbuild.config.ts",
    "serve": "http-server ./dist -p 3000 -s --cors -c-1",
    "test": "tsx tests/discovery.test.ts && tsx tests/navigation.test.ts && tsx tests/specifications.test.ts && tsx tests/http.test.ts && node tests/panel-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "http-server": "^14.1.1",
    "luna": "github:Inrixia/TidaLuna",
    "oby": "^15.1.2",
    "rimraf": "^6.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "version": "0.1.0",
  "author": {
    "name": "pimull",
    "url": "https://github.com/pimull"
  },
  "homepage": "https://github.com/pimull/tidaluna-album-editions",
  "repository": {
    "type": "git",
    "url": "https://github.com/pimull/tidaluna-album-editions.git"
  },
  "license": "AGPL-3.0-only",
  "private": true,
  "packageManager": "pnpm@10.5.2"
}
